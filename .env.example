# StoryLoom — environment template
# Copy to .env.local and fill in. None of these are required for the mock flow.

# Backend pipeline base URL (the existing GitHub backend).
# When set, the frontend POSTs to `${VITE_API_URL}/api/...` instead of using mocks.
VITE_API_URL=

# Payment provider — one of: "mock" | "stripe" | "paddle"
VITE_PAYMENT_PROVIDER=mock

# Stripe (publishable key only — safe to ship in the bundle).
# Secret key + webhook secret live in the backend / edge functions, never here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Paddle (client token only — safe to ship in the bundle).
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox